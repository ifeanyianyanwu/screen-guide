# Server-only (never prefix these with NEXT_PUBLIC_, they must not reach the browser)
TMDB_API_TOKEN='your-tmdb-read-access-token'
TMDB_BASE_URL='https://api.themoviedb.org/3'
# Must match JWT_SECRET of apps/server
SERVER_JWT_SECRET="your-auth-secret-here"
SERVER_BASE_URL="http://localhost:8080"

# Public (safe to expose to the browser)
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p/original"
